# Local template only. See docs/DEPLOYMENT.md. Never commit populated .env files.
APP_ENV=development
SITE_URL=http://localhost:3000
PRIMARY_DOMAIN=localhost
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Deployed Prisma 6 URLs require sslmode=require&sslaccept=strict and a trusted CA.
# DIRECT_DATABASE_URL must bypass transaction-mode pooling.
DATABASE_URL=postgresql://user:password@localhost:5432/rent_a_4wheel
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/rent_a_4wheel
MIGRATION_CONNECTION_MODE=direct
DEPLOYMENT_DATA_ENV=development
PROVIDER_ACCOUNT_ENV=development
PRIVATE_STORAGE_ENV=development
# Distinct high-entropy secrets, at least 32 characters, from a secret manager.
AUTH_SECRET=
CRON_SECRET=
RATE_LIMIT_STORE=postgres
SEED_ADMIN_EMAIL=
# Configure all three together, using TEST credentials only.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=US
FINANCE_SANDBOX_ENABLED=false
LIVE_FINANCE_ENABLED=false
ALLOW_DEV_PAYMENT_SIMULATION=false
RESEND_API_KEY=
EMAIL_FROM=Rent A 4Wheel <bookings@renta4wheel.com>
# S3 is mandatory in deployed environments. Blank provider permits local fixtures only.
PRIVATE_STORAGE_PROVIDER=
PRIVATE_STORAGE_REGION=
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_BUCKET=
# Full KMS key ARN: object responses must match this exact identity.
PRIVATE_STORAGE_KMS_KEY_ID=
PRIVATE_STORAGE_ACCESS_KEY_ID=
PRIVATE_STORAGE_SECRET_ACCESS_KEY=
# Legacy Cloudinary reads/imports only; new private deployed writes use S3.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ClamAV behind a restricted TLS endpoint; optional PEM CA for a private PKI.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TLS=true
CLAMAV_CA_CERT=
ALLOW_UNSCANNED_DOCUMENT_UPLOADS_IN_DEV=false
# HTTPS monitoring receiver must deduplicate Idempotency-Key deliveries.
MONITORING_ALERT_URL=
MONITORING_ALERT_SECRET=
# Optional SMS also requires server flag, handset consent and signed callbacks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Native login uses Verify, independently of optional notification SMS.
# disabled by default. Development/test may explicitly select fixture with a
# synthetic six-digit code; only +1 202-555-0100..0199 are accepted by fixtures.
# Real Twilio sends require staging/production AND this explicit opt-in.
MOBILE_SMS_PROVIDER=disabled
MOBILE_SMS_SEND_ENABLED=false
MOBILE_SMS_FIXTURE_CODE=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_INBOUND_URL=
# Public identifiers only. Never expose server credentials through NEXT_PUBLIC_*.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
