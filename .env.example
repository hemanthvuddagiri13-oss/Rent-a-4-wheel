# Rent A 4Wheel — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See README.md → "Third-Party Service Setup" for step-by-step provider setup.

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/rent_a_4wheel"

# --- Auth.js / NextAuth (required) ------------------------------------------
# Random secret used to sign session JWTs/cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of this deployment (used for callback URLs, absolute links).
NEXTAUTH_URL="http://localhost:3000"

# --- Site URL (used in metadata, sitemap, canonical/OG tags, emails) --------
NEXT_PUBLIC_SITE_URL="https://renta4wheel.com"

# --- Seed data (used only by `npm run db:seed`) -----------------------------
# Authentication is passwordless (email code) — there is no seed password.
SEED_ADMIN_EMAIL="admin@renta4wheel.com"

# --- Stripe (payments) -------------------------------------------------------
# Leave blank in development to fall back to the "Simulate Successful Payment"
# dev-mode panel in the booking wizard — no real charge is ever faked.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret from the Stripe webhook endpoint (payment_intent.succeeded /
# payment_intent.payment_failed). Required to verify webhook signatures.
STRIPE_WEBHOOK_SECRET=""

# --- Resend (transactional email) -------------------------------------------
# Leave blank in development — emails are logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Rent A 4Wheel <bookings@renta4wheel.com>"

# --- Cloudinary (vehicle photos + private document storage) ----------------
# Leave blank in development — uploads fall back to git-ignored ./private-storage
# on local disk, served only via the authenticated /api/documents/[id] route.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Twilio (SMS architecture — not yet wired to send) ----------------------
# Reserved for future SMS notifications once a consent flow is implemented.
# Leave blank; the app does not send SMS today.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Malware scanning (identity documents) ----------------------------------
# No scanning provider is wired up yet (see src/lib/documents.ts). In
# production, every upload is rejected fail-closed until one is configured.
# In development, set this to "true" to bypass that and exercise the
# booking flow locally. NEVER set this in production — it has no effect
# there regardless.
ALLOW_UNSCANNED_DOCUMENT_UPLOADS_IN_DEV="true"

# --- Background jobs ---------------------------------------------------------
# Shared secret required in the Authorization: Bearer header when calling
# /api/cron/expire-holds. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
