// Rent A 4Wheel — Prisma schema
// PostgreSQL datasource. All monetary values are stored as integer cents (USD)
// to avoid floating point rounding errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH & USERS
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  HOST
  HOST_EMPLOYEE
  STAFF
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)

  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  customer             Customer?
  hostProfile          HostProfile?
  hostEmployments      HostEmployee[]
  reservations         Reservation[]                 @relation("ReservationCustomer")
  documents            DriverDocument[]
  documentAccessLogs   DocumentAccessLog[]
  agreementAcceptances AgreementAcceptance[]
  notifications        Notification[]
  auditLogs            AuditLog[]                    @relation("AuditActor")
  tripEvents           TripEvent[]                   @relation("TripEventActor")
  tripChecklistEntries TripChecklist[]               @relation("TripChecklistActor")
  identityHandoffs     IdentityHandoffVerification[] @relation("IdentityHandoffHost")
  conditionReports     ConditionReport[]             @relation("ConditionReportSubmitter")
  emergencyOverrides   EmergencyOverrideRecord[]     @relation("EmergencyOverrideActor")
  reviews              Review[]
  contactMessages      ContactMessage[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// PASSWORDLESS EMAIL-CODE AUTHENTICATION
// ---------------------------------------------------------------------------

enum AuthCodePurpose {
  SIGN_IN
  EMERGENCY_OVERRIDE_STEP_UP
}

// Six-digit, single-use, short-lived, hashed sign-in codes. Never store the
// plaintext code — only a bcrypt hash. One row per code requested; the most
// recent non-consumed, non-expired row for an email is the "live" code.
model AuthCode {
  id      String          @id @default(cuid())
  email   String
  purpose AuthCodePurpose @default(SIGN_IN)

  codeHash String

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  requestIp String?

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt])
  @@index([requestIp, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Extended profile for customers (renters). Admin/staff capability is
// represented by User.role rather than a separate table, avoiding a
// redundant 1:1 mirror of User for privileged accounts.
model Customer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth  DateTime?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zip          String?
  country      String?   @default("US")

  licenseNumber     String?
  licenseState      String?
  licenseExpiration DateTime?

  verificationStatus DocumentStatus @default(PENDING_VERIFICATION)
  verificationNotes  String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

// ---------------------------------------------------------------------------
// HOST ARCHITECTURE
// ---------------------------------------------------------------------------

enum HostOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum StripeConnectStatus {
  NOT_CONNECTED
  ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

// A host is the party that lists and operates vehicles on the marketplace
// and receives payouts. Distinct from `VehicleOwner`, which tracks a purely
// financial/legal ownership arrangement for company-managed vehicles.
model HostProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String?
  legalName    String
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zip          String?
  country      String  @default("US")

  onboardingStatus HostOnboardingStatus @default(NOT_STARTED)
  approvedAt       DateTime?
  approvedById     String?

  stripeConnectAccountId String?
  stripeConnectStatus    StripeConnectStatus @default(NOT_CONNECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees HostEmployee[]
  vehicles  Vehicle[]

  @@index([onboardingStatus])
}

enum HostEmployeeRole {
  MANAGER
  STAFF
}

// Grants a user (who is not the host account owner) scoped access to a
// single host's vehicles and bookings — never to any other host's data.
model HostEmployee {
  id     String      @id @default(cuid())
  hostId String
  host   HostProfile @relation(fields: [hostId], references: [id], onDelete: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  role HostEmployeeRole @default(STAFF)

  createdAt DateTime @default(now())

  @@unique([hostId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// VEHICLES
// ---------------------------------------------------------------------------

enum VehicleCategory {
  ECONOMY
  SEDAN
  SUV
  LUXURY
  TRUCK
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  RETIRED
}

enum OwnershipType {
  COMPANY_OWNED
  LEASED_TO_COMPANY
  MANAGED_VEHICLE
}

model Vehicle {
  id   String @id @default(cuid())
  slug String @unique

  vin          String  @unique
  licensePlate String
  year         Int
  make         String
  model        String
  trim         String?
  color        String?
  mileage      Int     @default(0)

  category     VehicleCategory
  transmission Transmission    @default(AUTOMATIC)
  fuelType     FuelType        @default(GASOLINE)
  seats        Int             @default(5)
  doors        Int             @default(4)
  mpg          Int?

  description String?       @db.Text
  status      VehicleStatus @default(ACTIVE)
  isDemo      Boolean       @default(false)

  // Pricing — set independently by admin, stored as integer cents.
  dailyRateCents       Int
  weeklyRateCents      Int
  monthlyRateCents     Int
  securityDepositCents Int @default(0)

  mileageAllowancePerDay    Int @default(150)
  additionalMileageFeeCents Int @default(35)

  minRentalDays      Int  @default(1)
  maxRentalDays      Int?
  advanceNoticeHours Int  @default(2)

  // Compliance tracking
  registrationExpiresAt     DateTime?
  insuranceExpiresAt        DateTime?
  inspectionExpiresAt       DateTime?
  nextMaintenanceDueAt      DateTime?
  nextMaintenanceDueMileage Int?

  ownerId       String?
  owner         VehicleOwner? @relation(fields: [ownerId], references: [id])
  ownershipType OwnershipType @default(COMPANY_OWNED)

  // The host who lists/operates this vehicle and is paid out for it. Null
  // for company-owned demo/legacy inventory not yet assigned to a host.
  hostId String?
  host   HostProfile? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images               VehicleImage[]
  features             VehicleFeatureOnVehicle[]
  reservations         Reservation[]
  blocks               VehicleBlock[]
  inspections          VehicleInspection[]
  maintenanceRecords   MaintenanceRecord[]
  reviews              Review[]
  availability         VehicleAvailabilityConfig?
  agreementAcceptances AgreementAcceptance[]

  @@index([category])
  @@index([status])
  @@index([make, model])
  @@index([hostId])
}

model VehicleAvailabilityConfig {
  id        String  @id @default(cuid())
  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  isBookable    Boolean @default(true)
  blackoutNotes String? @db.Text

  updatedAt DateTime @updatedAt
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url       String
  publicId  String? // Cloudinary public id
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Feature {
  id   String  @id @default(cuid())
  name String  @unique
  icon String? // lucide icon name

  vehicles VehicleFeatureOnVehicle[]
}

model VehicleFeatureOnVehicle {
  vehicleId String
  featureId String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([vehicleId, featureId])
}

// ---------------------------------------------------------------------------
// VEHICLE OWNERSHIP (for leased / managed vehicles from third-party owners)
// ---------------------------------------------------------------------------

model VehicleOwner {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles   Vehicle[]
  agreements OwnerAgreement[]
}

enum PaymentArrangement {
  MONTHLY_FIXED
  REVENUE_SHARE
}

model OwnerAgreement {
  id      String       @id @default(cuid())
  ownerId String
  owner   VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?

  paymentArrangement  PaymentArrangement
  monthlyFixedCents   Int?
  revenueSharePercent Decimal?           @db.Decimal(5, 2)

  documentUrl String? // private, admin-only ownership/lease document
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// RESERVATIONS / BOOKING
// ---------------------------------------------------------------------------

// Full booking lifecycle state machine. Legal transitions are enforced in
// application code (see `src/lib/reservation-state-machine.ts`) using a
// compare-and-swap update so concurrent transition attempts can't race.
//
//   DRAFT -> CHECKOUT_HOLD -> AWAITING_PAYMENT -> CONFIRMED
//     -> DOCUMENTS_REQUIRED -> READY_FOR_CHECK_IN -> CHECK_IN_PROGRESS
//     -> READY_TO_START -> ACTIVE -> RETURN_IN_PROGRESS -> COMPLETED
//
// Side branches: PAYMENT_FAILED, EXPIRED, CANCELLED_BY_CUSTOMER,
// CANCELLED_BY_HOST, DISPUTED, UNDER_CLAIM_REVIEW.
enum ReservationStatus {
  DRAFT
  CHECKOUT_HOLD
  AWAITING_PAYMENT
  CONFIRMED
  DOCUMENTS_REQUIRED
  READY_FOR_CHECK_IN
  CHECK_IN_PROGRESS
  READY_TO_START
  ACTIVE
  RETURN_IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_HOST
  PAYMENT_FAILED
  EXPIRED
  DISPUTED
  UNDER_CLAIM_REVIEW
}

enum RateType {
  DAILY
  WEEKLY
  MONTHLY
}

model Reservation {
  bookingTimezone String @default("America/Chicago")
  financialCheckedAt DateTime?
  // Terminal financial disposition is independent of captured payment status.
  financialDisposition String @default("OPEN")
  bookingFingerprint String?
  checkoutFingerprint String?
  id                 String @id @default(cuid())
  confirmationNumber String @unique // e.g. RA4W-XXXXXX

  customerId String
  customer   User   @relation("ReservationCustomer", fields: [customerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  pickupAt       DateTime
  returnAt       DateTime
  pickupLocation String   @default("Dallas, TX")
  returnLocation String   @default("Dallas, TX")

  rateType        RateType
  rateAmountCents Int // the per-unit rate applied (daily/weekly/monthly) at booking time
  units           Int // number of days/weeks/months billed

  subtotalCents Int
  taxCents      Int @default(0)
  feesCents     Int @default(0)
  discountCents Int @default(0)
  extrasCents   Int @default(0)
  totalCents    Int
  depositCents  Int @default(0)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  status ReservationStatus @default(CHECKOUT_HOLD)

  // Deadline for the current transient phase (CHECKOUT_HOLD / AWAITING_PAYMENT).
  // Null once the reservation reaches a state with no expiry (CONFIRMED+).
  // Both the exclusion constraint (see migration) and background cleanup
  // ignore/release rows once this passes, so an unpaid hold can never block
  // inventory indefinitely.
  expiresAt DateTime?

  // Driver/license fields are collected during the checkout step (after the
  // hold exists) and are therefore optional until the AWAITING_PAYMENT
  // transition, which requires them all to be present.
  driverFirstName   String?
  driverLastName    String?
  driverDob         DateTime?
  driverEmail       String?
  driverPhone       String?
  driverAddress     String?
  driverCity        String?
  driverState       String?
  driverZip         String?
  driverCountry     String    @default("US")
  licenseNumber     String?
  licenseState      String?
  licenseExpiration DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extras                 ReservationExtra[]
  payments               Payment[]
  refunds                Refund[]
  deposit                SecurityDeposit?
  documents              DriverDocument[]
  agreementAcceptances   AgreementAcceptance[]
  inspections            VehicleInspection[]
  damageReports          DamageReport[]
  notifications          Notification[]
  trip                   Trip?
  conditionReports       ConditionReport[]
  identityHandoff        IdentityHandoffVerification?
  tripChecklistEntries   TripChecklist[]
  tripEvents             TripEvent[]
  paymentReconciliations PaymentReconciliation[]
  emergencyOverrides     EmergencyOverrideRecord[]

  // Postgres-only generated column backing the overlap exclusion constraint
  // added by hand in the phase1 migration SQL (Prisma Migrate can't express
  // GENERATED ALWAYS AS / EXCLUDE USING gist). Never write to this field and
  // never edit it via schema changes — edit the migration SQL directly.
  duringRange Unsupported("tsrange")?

  @@index([vehicleId, pickupAt, returnAt])
  @@index([customerId])
  @@index([status])
  @@index([status, expiresAt])
}

model Extra {
  id          String          @id @default(cuid())
  name        String
  description String?
  chargeType  ExtraChargeType
  amountCents Int? // for ONE_TIME / DAILY
  percent     Decimal?        @db.Decimal(5, 2) // for PERCENTAGE
  isActive    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations ReservationExtra[]
}

enum ExtraChargeType {
  ONE_TIME
  DAILY
  PERCENTAGE
}

model ReservationExtra {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  extraId String
  extra   Extra  @relation(fields: [extraId], references: [id])

  quantity    Int @default(1)
  amountCents Int // computed line total at time of booking

  @@index([reservationId])
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentType {
  RENTAL
  DEPOSIT_AUTH
  DEPOSIT_CAPTURE
  ADDITIONAL_CHARGE
}

model Payment {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  type   PaymentType
  status PaymentStatus @default(REQUIRES_PAYMENT)

  amountCents Int
  currency    String @default("usd")

  stripePaymentIntentId String? @unique
  idempotencyKey        String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([reservationId])
  @@index([status])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

// Doubles as the durable, idempotent "refund operation" record: a row is
// created here in PENDING status (with a deterministic, unique
// `idempotencyKey`) BEFORE the Stripe refund API is ever called. Any
// retry/replay (a crash between the Stripe call succeeding and this row
// being updated, a webhook re-delivery, a duplicate staff click) looks up
// the existing row by `idempotencyKey` first instead of re-calling
// Stripe. Creating a Refund row is NOT refund completion — only
// `status: SUCCEEDED` is; see src/lib/refund-operations.ts.
model Refund {
  legacyUncertain Boolean @default(false)
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  amountCents    Int
  reason         String?
  status         RefundStatus @default(PENDING)
  stripeRefundId String?      @unique

  idempotencyKey String  @unique
  initiatedById  String? // null = system/reconciliation-initiated; set = staff-initiated
  lastError      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
}

model BookingDraft {
  id String @id
  customerId String
  vehicleId String
  revision Int @default(0)
  fingerprint String?
  reservationId String?
  updatedAt DateTime @updatedAt
  @@index([customerId, vehicleId])
}

model SecurityDeposit {
  capturableAmountCents Int @default(0)
  operation FinancialOperation? @relation(fields: [operationId], references: [id])
  legacyUncertain Boolean @default(false)
  generation Int @default(0)
  operationId String?
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  amountCents           Int
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  stripePaymentIntentId String?       @unique
  capturedAmountCents   Int?
  failureReason         String?
  releasedAt            DateTime?

  // The raw Stripe PaymentIntent status at last sync (e.g.
  // "requires_capture", "canceled") — an authorization is only genuinely
  // valid when this is "requires_capture"; a resolved create() call alone
  // does not guarantee that (see src/lib/deposit-authorization.ts).
  stripeStatus String?

  // When the manual-capture authorization actually succeeded, and our
  // conservative estimate of when Stripe will auto-release it if never
  // captured (uncaptured card authorizations are not held indefinitely).
  // Trip start requires `authorizationExpiresAt` to still be in the
  // future — see src/lib/trip-gate.ts.
  authorizedAt           DateTime?
  authorizationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StripeEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// Idempotency + retry ledger for Stripe webhook deliveries. Stripe (and any
// proxy in front of it) may deliver the same event more than once, or
// deliver events out of order. Every event is claimed here by its unique
// Stripe event ID before any side effect runs, moves through
// RECEIVED -> PROCESSING -> PROCESSED (success) or FAILED (retryable), and
// is only ever considered "done" once `status = PROCESSED` — a duplicate
// PROCESSED event is a no-op, a duplicate RECEIVED/FAILED event (or a
// PROCESSING event whose `processingStartedAt` is stale) is safely
// re-claimable. See src/lib/stripe-event-ledger.ts.
model StripeEvent {
  id            String            @id @default(cuid())
  stripeEventId String            @unique
  type          String
  status        StripeEventStatus @default(RECEIVED)

  attemptCount Int @default(0)

  lastError String? @db.Text

  receivedAt          DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  nextRetryAt         DateTime?

  // Fencing token: a fresh random value generated on every successful
  // claim (initial or recovery). `markProcessed`/`markFailed` require the
  // caller's token to still match the row's current token — if a recovery
  // worker has since reclaimed a stale PROCESSING row (generating a new
  // token), the original, merely-slow worker's eventual completion can no
  // longer overwrite the newer worker's outcome. See
  // src/lib/stripe-event-ledger.ts.
  leaseToken String?

  payload Json?

  @@index([type])
  @@index([status])
}

enum OutboxMessageStatus {
  PENDING
  SENT
  FAILED
}

// Transactional outbox: notifications and other required post-payment
// side effects are written here in the SAME database transaction as the
// state change that requires them, then dispatched separately (see
// src/lib/outbox.ts) — so a crash after the state change commits can
// never lose the notification, and a notification can never be sent for
// a state change that itself rolled back.
model OutboxMessage {
  firstAttemptAt DateTime?
  deliveryKey String? @unique
  leaseToken String?
  leaseExpiresAt DateTime?
  id      String              @id @default(cuid())
  type    String
  payload Json
  status  OutboxMessageStatus @default(PENDING)

  attempts  Int     @default(0)
  lastError String? @db.Text

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  nextRetryAt DateTime?

  @@index([status, nextRetryAt])
}

// Immutable provider request plus resumable execution state. Payload contains
// provider IDs, never card details. Unknown outcomes retain their original key.
model FinancialOperation {
  consecutiveFailures Int @default(0)
  deposits SecurityDeposit[]
  generation Int?
  priority Int @default(50)
  id String @id @default(cuid())
  key String @unique
  kind String
  reservationId String?
  fingerprint String
  payload Json
  providerId String?
  result Json?
  state String @default("READY")
  leaseToken String?
  leaseExpiresAt DateTime?
  firstAttemptAt DateTime?
  nextAttemptAt DateTime?
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([kind, state, priority, nextAttemptAt, createdAt], map: "financial_recovery_due_idx")
  @@index([reservationId, kind])
}

enum ReconciliationReason {
  DEPOSIT_AUTH_SUCCEEDED_DB_UPDATE_FAILED
  PAYMENT_SUCCEEDED_AFTER_HOLD_EXPIRED
  PAYMENT_SUCCEEDED_DATES_UNAVAILABLE
  PAYMENT_SUCCEEDED_AFTER_CANCELLATION
  DEPOSIT_RECOVERY_WINDOW_EXPIRED
  WEBHOOK_PROCESSING_REPEATEDLY_FAILED
}

enum ReconciliationStatus {
  OPEN
  AUTO_RESOLVED
  REFUNDED
  NEEDS_MANUAL_REVIEW
  RESOLVED
}

// Records every case where a Stripe payment succeeded but could not be
// cleanly turned into a confirmed reservation (hold expired mid-payment,
// dates became unavailable, or a DB failure struck after a successful
// Stripe-side charge/authorization). The invariant this model exists to
// guarantee: a successful charge never silently disappears — it always
// ends up either auto-resolved into a valid reservation, refunded, or
// flagged here for a human. See src/lib/payment-reconciliation.ts.
model PaymentReconciliation {
  id String @id @default(cuid())

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  paymentId             String?
  stripePaymentIntentId String?

  reason ReconciliationReason
  status ReconciliationStatus @default(OPEN)

  detail   Json?
  refundId String?

  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status])
  @@index([reservationId])
}

// An audited, step-up-verified escape hatch for staff to force a
// reservation past a gate it hasn't actually satisfied (e.g. starting a
// trip whose documents/identity-handoff/condition-reports aren't
// complete). Never exposed as an ordinary admin action — see
// src/lib/emergency-override.ts and the SUPER_ADMIN-only route that
// creates these.
model EmergencyOverrideRecord {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  actorId String
  actor   User   @relation("EmergencyOverrideActor", fields: [actorId], references: [id])

  action           String // e.g. "FORCE_START_TRIP", "FORCE_COMPLETE_TRIP"
  reason           String            @db.Text
  originalStatus   ReservationStatus
  resultingStatus  ReservationStatus
  unmetGateReasons Json

  // Timestamp of the fresh step-up email-code verification required
  // immediately before this override (AuthCodePurpose.EMERGENCY_OVERRIDE_STEP_UP)
  // — the closest equivalent to "recent MFA" this system can enforce, since
  // no TOTP/WebAuthn factor exists yet. Documented explicitly as a scoping
  // decision, not silently substituted.
  stepUpVerifiedAt DateTime

  createdAt DateTime @default(now())

  @@index([reservationId])
}

// ---------------------------------------------------------------------------
// DRIVER DOCUMENTS (private storage only)
// ---------------------------------------------------------------------------

enum DocumentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

enum DocumentType {
  LICENSE_FRONT
  LICENSE_BACK
  SELFIE_WITH_LICENSE
}

enum MalwareScanStatus {
  QUARANTINED
  CLEAN
  INFECTED
  SCAN_UNAVAILABLE
}

model DriverDocument {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  type DocumentType

  // Private storage key/URL only — never served publicly. Access must go
  // through an authenticated, signed route (see /api/documents/[id]), which
  // also writes a DocumentAccessLog row on every read.
  storageKey    String
  mimeType      String
  fileSizeBytes Int
  contentSha256 String // integrity fingerprint of the re-encoded file, not the raw upload

  malwareScanStatus MalwareScanStatus @default(QUARANTINED)

  // Configurable retention: documents are eligible for deletion by the
  // retention-cleanup job once this passes (see PlatformSetting-driven
  // default in src/lib/documents.ts). Null = retention not yet computed.
  retentionExpiresAt DateTime?
  deletedAt          DateTime?

  status       DocumentStatus @default(PENDING_VERIFICATION)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessLogs DocumentAccessLog[]

  @@index([userId])
  @@index([reservationId])
  @@index([status])
  @@index([retentionExpiresAt])
}

// Every time a driver document (license image, selfie) is read — by its
// owner or by a reviewer/host — a row is written here. Never mutated or
// deleted by application code; this is the access audit trail.
model DocumentAccessLog {
  id         String         @id @default(cuid())
  documentId String
  document   DriverDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  accessedById String
  accessedBy   User   @relation(fields: [accessedById], references: [id])

  purpose   String // e.g. "owner_view", "staff_review", "host_pickup_verification"
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([accessedById])
}

// ---------------------------------------------------------------------------
// VERSIONED LEGAL AGREEMENT ACCEPTANCE (e-sign workflow)
// ---------------------------------------------------------------------------

enum LegalDocumentType {
  RENTAL_AGREEMENT
  HOST_AGREEMENT
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  CANCELLATION_POLICY
  INSURANCE_POLICY
  DAMAGE_POLICY
  SECURITY_DEPOSIT_POLICY
}

// An immutable record of one signer accepting one exact version of a legal
// document. `contentHash`/`contentSnapshot` freeze what was actually shown
// and signed even if the editable `LegalDocument` row is revised later.
// Creating one is refused server-side while the source LegalDocument is
// still flagged `needsAttorneyReview` (see src/lib/agreements.ts).
model AgreementAcceptance {
  id   String            @id @default(cuid())
  type LegalDocumentType

  documentVersion String
  contentHash     String // sha256 hex of contentSnapshot
  contentSnapshot String @db.Text

  // Exactly one of these is set, depending on `type`.
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])

  signedByUserId String
  signedByUser   User   @relation(fields: [signedByUserId], references: [id])
  signerName     String

  signedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?  @db.Text

  // Private-storage key for the generated, immutable signed PDF snapshot.
  signedPdfStorageKey String?

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([vehicleId])
  @@index([signedByUserId])
}

// Admin-editable legal content. Content flagged `needsAttorneyReview` must
// display a clear placeholder warning until reviewed by a licensed Texas
// attorney — see README "Legal" section.
model LegalDocument {
  id                  String            @id @default(cuid())
  type                LegalDocumentType @unique
  version             String            @default("v1-draft")
  title               String
  content             String            @db.Text
  needsAttorneyReview Boolean           @default(true)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------------------
// TRIP LIFECYCLE (check-in -> active trip -> return)
// ---------------------------------------------------------------------------

// One row per reservation once the trip actually starts. Separate from
// Reservation so pickup/return odometer+fuel readings have an unambiguous
// home distinct from the fleet-wide VehicleInspection log.
model Trip {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  startedAt       DateTime?
  startedByUserId String?
  startMileage    Int?
  startFuelLevel  Int? // percentage 0-100

  endedAt       DateTime?
  endedByUserId String?
  endMileage    Int?
  endFuelLevel  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ConditionReportPhase {
  PRE_TRIP
  POST_TRIP
}

enum SubmitterRole {
  CUSTOMER
  HOST
}

// A condition report is one party's (customer's or host's) record of the
// vehicle's state at pickup or return. Both a customer and a host report
// are required per phase; a trip cannot start (or a return cannot
// complete) until both exist and both have been accepted by their author.
model ConditionReport {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  phase ConditionReportPhase

  submittedByRole SubmitterRole
  submittedById   String
  submittedBy     User          @relation("ConditionReportSubmitter", fields: [submittedById], references: [id])

  mileage     Int
  fuelLevel   Int
  damageNotes String? @db.Text

  // Set once the *author* explicitly accepts their own report as accurate.
  // "Both parties accepted the condition report" (trip-start gate) means a
  // customer PRE_TRIP report and a host PRE_TRIP report both have this set.
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  photos ConditionPhoto[]

  @@index([reservationId, phase])
}

enum ConditionPhotoCategory {
  EXTERIOR
  INTERIOR
  ODOMETER
  FUEL_GAUGE
  DAMAGE
}

model ConditionPhoto {
  id                String          @id @default(cuid())
  conditionReportId String
  conditionReport   ConditionReport @relation(fields: [conditionReportId], references: [id], onDelete: Cascade)

  category   ConditionPhotoCategory
  storageKey String // private storage — never public

  createdAt DateTime @default(now())

  @@index([conditionReportId])
}

// The host's in-person verification, at pickup, that the physical license
// matches the uploaded documents and the customer matches the selfie. This
// is a hard gate on Start Trip and cannot be self-certified by the customer.
model IdentityHandoffVerification {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  verifiedByHostId String
  verifiedByHost   User   @relation("IdentityHandoffHost", fields: [verifiedByHostId], references: [id])

  licenseMatchesUpload     Boolean @default(false)
  physicalLicenseUnexpired Boolean @default(false)
  selfieMatchesCustomer    Boolean @default(false)

  notes      String?   @db.Text
  verifiedAt DateTime?

  @@index([reservationId])
}

enum TripChecklistPhase {
  PICKUP
  RETURN
}

// Append-only log of individual checklist steps completed by either party
// during pickup or return, each attributable to a specific actor and time
// (e.g. "customer confirmed pickup location", "host confirmed keys handed
// over"). Queried by step key rather than modeled as fixed columns so new
// steps can be added without a migration.
model TripChecklist {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  phase TripChecklistPhase
  role  SubmitterRole
  step  String

  completedById String
  completedBy   User     @relation("TripChecklistActor", fields: [completedById], references: [id])
  completedAt   DateTime @default(now())

  @@unique([reservationId, phase, role, step])
  @@index([reservationId])
}

// Reservation-scoped lifecycle audit trail: state transitions, hold
// creation, payment/deposit outcomes, document approvals, identity
// verification, condition-report submission, trip start/end. Distinct from
// the platform-wide `AuditLog`, which is oriented around admin actions.
model TripEvent {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  type     String
  actorId  String?
  actor    User?   @relation("TripEventActor", fields: [actorId], references: [id])
  metadata Json?

  createdAt DateTime @default(now())

  @@index([reservationId, createdAt])
}

// ---------------------------------------------------------------------------
// FLEET OPERATIONS
// ---------------------------------------------------------------------------

enum BlockReason {
  MAINTENANCE
  ADMIN_HOLD
  OWNER_REQUEST
  OTHER
}

model VehicleBlock {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  reason  BlockReason @default(OTHER)
  notes   String?     @db.Text

  createdAt DateTime @default(now())

  @@index([vehicleId, startAt, endAt])
}

enum InspectionType {
  CHECK_OUT
  CHECK_IN
}

model VehicleInspection {
  id            String      @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  type InspectionType

  mileage       Int
  fuelLevel     Int // percentage 0-100
  photoUrls     String[] // private storage URLs
  damageNotes   String?  @db.Text
  performedById String?
  performedAt   DateTime @default(now())

  lateReturn            Boolean @default(false)
  additionalMileage     Int     @default(0)
  additionalChargeCents Int     @default(0)

  @@index([vehicleId])
  @@index([reservationId])
}

model DamageReport {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  description        String   @db.Text
  photoUrls          String[]
  estimatedCostCents Int?
  chargedCents       Int?

  createdAt DateTime @default(now())

  @@index([reservationId])
}

enum MaintenanceType {
  OIL_CHANGE
  TIRES
  BRAKES
  INSPECTION
  REGISTRATION
  INSURANCE
  REPAIR
  CLEANING
  OTHER
}

model MaintenanceRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  service            MaintenanceType
  serviceDate        DateTime
  mileage            Int
  costCents          Int
  vendor             String?
  nextServiceDate    DateTime?
  nextServiceMileage Int?
  notes              String?         @db.Text

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// MARKETING / SUPPORT
// ---------------------------------------------------------------------------

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id   String @id @default(cuid())
  code String @unique

  discountType CouponDiscountType
  amountCents  Int? // for FIXED
  percent      Decimal?           @db.Decimal(5, 2) // for PERCENTAGE

  startsAt      DateTime
  expiresAt     DateTime
  minRentalDays Int?
  maxUses       Int?
  usedCount     Int      @default(0)

  applicableVehicleIds String[] // empty = all vehicles

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@index([code])
}

model Review {
  id String @id @default(cuid())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  authorName  String
  rating      Int // 1-5
  comment     String  @db.Text
  isPublished Boolean @default(false)
  isDemo      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

model ContactMessage {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  name    String
  email   String
  phone   String?
  message String  @db.Text

  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
}

model FaqCategory {
  id       String @id @default(cuid())
  name     String @unique
  position Int    @default(0)

  faqs Faq[]
}

model Faq {
  id         String      @id @default(cuid())
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  question    String
  answer      String  @db.Text
  position    Int     @default(0)
  isPublished Boolean @default(true)

  @@index([categoryId])
}

enum NotificationType {
  BOOKING_CONFIRMATION
  PAYMENT_RECEIPT
  DEPOSIT_AUTH_FAILED
  UPCOMING_RENTAL_REMINDER
  DRIVER_VERIFICATION_REQUEST
  PICKUP_REMINDER
  RETURN_REMINDER
  CANCELLATION
  REFUND
  LATE_RETURN
  TRIP_EMERGENCY_OVERRIDE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  deliveryKey String? @unique
  id String @id @default(cuid())

  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  type    NotificationType
  channel NotificationChannel @default(EMAIL)
  status  NotificationStatus  @default(PENDING)

  subject String?
  payload Json?
  error   String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  action     String // e.g. "vehicle.update", "reservation.cancel"
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// Admin-configurable, no-code business settings (task 34). Single source of
// truth read via `getSiteSettings()` with in-memory fallback defaults.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Durable operator queue. IDs/evidence are retained after resolution.
model FinancialCase {
  id String @id @default(cuid())
  sourceKey String @unique
  reservationId String
  customerId String
  operationId String?
  refundId String?
  kind String
  amountCents Int
  currency String @default("usd")
  originalKey String?
  providerId String?
  reason String
  evidence Json?
  status String @default("OPEN")
  assignedToId String?
  attempts Int @default(0)
  lastError String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  @@index([status, createdAt])
  @@index([reservationId])
}
